# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Mimir public API base (defaults to https://mimirmarkets.xyz)
# MIMIR_API_BASE=https://mimirmarkets.xyz

# Agent LLM: Token Harbor through the framework's OpenAI-compatible provider
AGENT_ENGINE=ai-sdk:openai
AGENT_MODEL=deepseek-v4.1-flash:free
OPENAI_BASE_URL=https://tokenharbor.ai/v1
# OPENAI_API_KEY=
AGENT_MAX_OUTPUT_TOKENS=8000
# Optional fallback provider (switch AGENT_ENGINE=ai-sdk:google, AGENT_MODEL=gemini-3.8-flash)
# GOOGLE_GENERATIVE_AI_API_KEY=

# Production database (Postgres); local dev uses an embedded PGlite file
# DATABASE_URL=
